# Local SQLite database; the server creates and seeds it on first start.
DATABASE_PATH=storage/cmemp.sqlite
PORT=3104
# Explicitly enable local OTP testing. Codes are returned in the UI; no SMS is sent.
DEMO_AUTH=true
# Set a strong password before starting. No admin account is created without this.
ADMIN_PASSWORD=
ADMIN_PHONE=9000000000
# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false

WEB_PORT=5184
WEB_ORIGIN=http://127.0.0.1:5184
